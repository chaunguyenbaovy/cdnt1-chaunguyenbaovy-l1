        <!-- Legend Box -->
        <mxCell id="leg" value="CHÚ THÍCH KÝ HIỆU (LEGEND):&#10;• Actor: Vai trò người dùng / System Timer  |  • UC (Ellipse): Chức năng  |  • &lt;&lt;include&gt;&gt;: Bắt buộc  |  • &lt;&lt;extend&gt;&gt;: Mở rộng&#10;TRUY VẾT VẤN ĐỀ &amp; QUY TẮC: V1 (Trùng 18-22% SĐT), V5 (Lãng phí tiếp thị), QT-01 (SĐT duy nhất), QT-02 (Regex 10 số), QT-12 (VIP/REG), QT-13 (Soft delete), QT-15 (Mask SĐT)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
